{
  "info": {
    "name": "Multi-Tenant SaaS API",
    "description": "Complete API collection for the Multi-Tenant Task Management SaaS",
    "_postman_id": "multi-tenant-saas-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Auto-set after login or register"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Check if server is running"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (creates user + tenant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved automatically');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Raghav\",\n  \"email\": \"raghav@acmecorp.com\",\n  \"password\": \"password123\",\n  \"orgName\": \"Acme Corp\"\n}"
            },
            "description": "Creates a new user AND a new tenant. The user becomes admin of that tenant. Token is auto-saved to collection variable."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved automatically');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"raghav@acmecorp.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Login with email + password. Token is auto-saved."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Blacklists the current token in Redis. Token is unusable after this."
          }
        },
        {
          "name": "Register - Validation Error (missing fields)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"notvalid\",\n  \"password\": \"123\"\n}"
            },
            "description": "Should return 422 with validation errors"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Build authentication module\",\n  \"description\": \"Implement JWT auth with refresh tokens\",\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"tags\": [\"backend\", \"auth\"],\n  \"deadline\": \"2026-06-01T00:00:00.000Z\"\n}"
            },
            "description": "Creates a task scoped to the logged-in user's tenant. tenantId comes from JWT — not from body."
          }
        },
        {
          "name": "Create Task with Metadata (flexible schema)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design new dashboard\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\",\n  \"metadata\": {\n    \"storyPoints\": 8,\n    \"sprint\": \"Sprint 3\",\n    \"epicLabel\": \"UI Revamp\"\n  }\n}"
            },
            "description": "Shows MongoDB flexible schema — metadata can be anything per tenant"
          }
        },
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Returns all tasks for this tenant. First call hits MongoDB, subsequent calls return from Redis cache. Check response for 'fromCache: true'."
          }
        },
        {
          "name": "Get All Tasks - Filter by Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=in_progress",
              "query": [
                { "key": "status", "value": "in_progress" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Filter tasks by status. Options: todo, in_progress, in_review, done"
          }
        },
        {
          "name": "Get All Tasks - Filter by Priority",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?priority=high",
              "query": [
                { "key": "priority", "value": "high" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Filter tasks by priority. Options: low, medium, high, critical"
          }
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/PASTE_TASK_ID_HERE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Replace PASTE_TASK_ID_HERE with a real _id from Get All Tasks response"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/PASTE_TASK_ID_HERE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\",\n  \"priority\": \"low\"\n}"
            },
            "description": "Partial update — only send fields you want to change. Invalidates Redis cache."
          }
        },
        {
          "name": "Delete Task (admin only)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/PASTE_TASK_ID_HERE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "description": "Only admin role can delete. Returns 403 if role is member or viewer."
          }
        },
        {
          "name": "Get Tasks - No Token (should 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks",
            "description": "No Authorization header — should return 401 Unauthorized"
          }
        },
        {
          "name": "Get Tasks - Invalid Token (should 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              { "key": "Authorization", "value": "Bearer thisisafaketoken" }
            ],
            "description": "Invalid JWT — should return 401 Invalid token"
          }
        }
      ]
    }
  ]
}